# Copy to .env and fill in. Used by `docker compose up` (provisioning/datasources/datasources.yml).
# Platform API URL, see https://www.qualys.com/platform-identification/
QUALYS_API_URL=https://qualysapi.qg2.apps.qualys.eu
QUALYS_USERNAME=myapiuser
# base64 of "user:password"
#   PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("myapiuser:secret"))
#   bash:       printf '%s' 'myapiuser:secret' | base64
QUALYS_BASIC_AUTH=
